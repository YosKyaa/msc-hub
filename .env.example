APP_NAME="MSC Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# WAJIB diisi dengan domain produksi. Nilai ini dipakai untuk membuat URL
# absolut di QR sertifikat, tautan absensi, dan tombol di email.
APP_URL=http://localhost

# Production: APP_ENV=production, APP_DEBUG=false
# APP_ENV=production
# APP_DEBUG=false

# Zona waktu aplikasi. Semua window absensi dan tampilan tanggal memakai WIB.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=msc_hub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Harus minimal sebesar MSC_REQUESTER_IDLE_TIMEOUT, kalau tidak cookie mati
# lebih dulu dan peserta acara terlempar di antara check-in dan check-out.
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

# Batas waktu login (menit). idle = tanpa permintaan; absolute = batas keras
# sejak login, seaktif apa pun penggunanya. Isi 0 untuk mematikan salah satu.
# Peminjam dan peserta acara: menganggur berjam-jam di antara check-in dan
# check-out, jadi batas menganggurnya longgar.
MSC_REQUESTER_IDLE_TIMEOUT=480
MSC_REQUESTER_ABSOLUTE_TIMEOUT=720
# Panel memegang persetujuan dan penerbitan sertifikat, jadi lebih ketat.
MSC_PANEL_IDLE_TIMEOUT=120
MSC_PANEL_ABSOLUTE_TIMEOUT=480
# Umur satu percobaan login Google, sejak diarahkan sampai kembali.
MSC_LOGIN_ATTEMPT_TIMEOUT=15

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated operational recipients for new submissions
MSC_NOTIFICATION_RECIPIENTS="media@jgu.ac.id,chika@jgu.ac.id,yosua@jgu.ac.id,hadi@jgu.ac.id"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (untuk Content Request)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
